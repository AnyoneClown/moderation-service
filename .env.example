# ── Environment variables for the Content Moderation System ──
# Copy this file to .env and fill in real values before running.

# ── PostgreSQL ──
# Local Docker database settings
POSTGRES_USER=moderation_user
POSTGRES_PASSWORD=moderation_pass
POSTGRES_DB=moderation_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Assembled DATABASE_URL used by SQLAlchemy (async driver).
# Local default:
DATABASE_URL=postgresql+asyncpg://moderation_user:moderation_pass@db:5432/moderation_db
# For Supabase, paste the Session pooler or Direct connection string here.
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Database SSL mode:
# - prefer: local Docker default
# - require: encrypted connection without certificate verification
# - verify-full: encrypted connection with certificate verification
DATABASE_SSL_MODE=prefer
DATABASE_POOL_PRE_PING=true

# ── NVIDIA NIM ──
# OpenAI-compatible API key for https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-120b

# ── Hugging Face ──
# Inference API token (https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_REPLACE_ME
